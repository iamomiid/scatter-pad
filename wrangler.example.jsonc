// Copy this file to wrangler.jsonc (which is gitignored) and fill in your own values.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scatter-pad",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Optional: serve on your own domain instead of workers.dev.
  // "routes": [{ "pattern": "todo.example.com", "custom_domain": true }],
  // "workers_dev": false,
  // "preview_urls": false,
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scatter-pad",
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "migrations"
    }
  ]
}
